# SMTP settings for contact modal message delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_google_app_password

# Optional override recipient. If omitted, SMTP_USER is used.
CONTACT_RECEIVER_EMAIL=your.email@gmail.com

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Neon Auth URL from the Neon console Configuration tab.
# Use the full auth URL, for example:
# https://ep-xxx.neonauth.us-east-2.aws.neon.build/neondb/auth
NEON_AUTH_URL=

# The single email address allowed to manage the blog studio.
ADMIN_EMAIL=your.admin@email.com
